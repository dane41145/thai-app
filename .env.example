# Copy this file to .env and fill in your keys — the app loads it at startup.
# The app runs without keys, but audio (Azure) and Speaking mode (Gemini)
# will be unavailable.

# Azure Speech Services (text-to-speech)
AZURE_KEY=
AZURE_REGION=southeastasia

# Google Gemini (AI sentence generation for Speaking mode)
GEMINI_KEY=

# Optional. Gemini model for Speaking mode (gemini-2.0-flash was retired 2026-06-01).
# GEMINI_MODEL=gemini-3.5-flash

# Optional. Where per-deck progress is saved. On Render, point this at a
# persistent disk or progress is wiped on every deploy.
# PROGRESS_FILE=/var/data/progress.json
